source https://api.nuget.org/v3/index.json
cache ./nuget-package-caches

framework: net10.0, net10.0-windows10.0.17763.0
storage: none
strategy: min

nuget Microsoft.Extensions.Hosting >= 10.0.0
nuget Microsoft.Extensions.Options >= 10.0.0
nuget Microsoft.Extensions.Options.ConfigurationExtensions >= 10.0.0
nuget Microsoft.AspNetCore.DataProtection >= 10.0.0
nuget Microsoft.Extensions.Http >= 10.0.0
nuget Microsoft.EntityFrameworkCore.Sqlite >= 10.0.0
nuget Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson >= 10.0.0

nuget Microsoft.Win32.Registry 5.0.0
nuget Microsoft.Xaml.Behaviors.Wpf 1.1.39

nuget MahApps.Metro 2.4.9
nuget MediatR 12.4.1
nuget MediatR.Extensions.Microsoft.DependencyInjection 11.0.0
nuget Swashbuckle.AspNetCore 7.2.0
nuget Swashbuckle.AspNetCore.Newtonsoft 7.2.0
nuget IronPython 3.4.1
nuget HandyControl 3.5.1
nuget ReactiveProperty 9.8.0
nuget ReactiveProperty.WPF 9.8.0

nuget System.Text.Encoding.CodePages 8.0.0
nuget System.Text.Encodings.Web >= 8.0.0
nuget System.Text.Json >= 8.0.0
nuget System.Threading.Tasks.Extensions 4.5.4

nuget xunit 2.9.3
nuget Microsoft.NET.Test.Sdk 17.12.0
nuget xunit.runner.visualstudio 3.0.1
nuget Xunit.Priority 1.1.6