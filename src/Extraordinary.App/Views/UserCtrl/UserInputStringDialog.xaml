<Window
    x:Class="Extraordinary.App.Views.UserCtrl.UserInputStringDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Extraordinary.App.Views.UserCtrl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ele"
    Width="400"
    Height="150"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding UserTitle, ElementName=ele}" />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="请输入：" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Height="32"
            MinWidth="250"
            Margin="10"
            Text="{Binding StringValue, ElementName=ele}" />
        <Button
            x:Name="Confirm"
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Click="Confirm_Click"
            Content="确认"
            Style="{StaticResource ButtonPrimary}" />
    </Grid>
</Window>
