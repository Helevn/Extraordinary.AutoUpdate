<Page
    x:Class="Extraordinary.App.Views.ParamMgmt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Extraordinary.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ParamMgmtVM}"
    Background="{DynamicResource RegionBackground}"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="TitleBackground" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="GroupBorder" Color="#FFCCCCCC" />
        <FontFamily x:Key="BaseFont">Microsoft YaHei</FontFamily>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            Padding="5"
            Background="{StaticResource TitleBackground}"
            CornerRadius="4">
            <Button
                Width="40"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding CmdGoBack}"
                Style="{StaticResource ButtonCustom}"
                ToolTip="返回">
                <Viewbox>
                    <Path
                        Data="M20,11 L7.83,11 L13.42,5.41 L12,4 L4,12 L12,20 L13.41,18.59 L7.83,13 L20,13 L20,11 Z"
                        Fill="White"
                        Stretch="Uniform" />
                </Viewbox>
            </Button>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox
                        Margin="0,0,0,15"
                        BorderBrush="{StaticResource GroupBorder}"
                        Header="服务器设置">
                        <StackPanel>
                            <StackPanel Margin="0,8" Orientation="Horizontal">
                                <Label
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Content="URL地址：" />
                                <TextBox
                                    x:Name="text_ServerUrl"
                                    Height="32"
                                    MinWidth="350"
                                    hc:InfoElement.Placeholder="例如：http://server.com/api"
                                    Text="{Binding ServerUrl.Value}" />
                            </StackPanel>

                            <StackPanel Margin="0,8" Orientation="Horizontal">
                                <Label
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Content="下载位置：" />
                                <TextBox
                                    x:Name="text_DownloadPath"
                                    Height="32"
                                    MinWidth="300"
                                    Text="{Binding DownloadPath.Value}" />
                                <Button
                                    x:Name="btn_BrowseDownload"
                                    Width="70"
                                    Margin="10,0,0,0"
                                    Click="BtnBrowseDownload_Click"
                                    Content="浏览..." />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        Margin="0,0,0,15"
                        BorderBrush="{StaticResource GroupBorder}"
                        Header="应用程序设置">
                        <StackPanel>
                            <StackPanel Margin="0,8" Orientation="Horizontal">
                                <Label
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Content="程序名称：" />
                                <TextBox
                                    x:Name="text_AppName"
                                    Height="32"
                                    MinWidth="350"
                                    Text="{Binding AppName.Value}" />
                            </StackPanel>

                            <StackPanel Margin="0,8" Orientation="Horizontal">
                                <Label
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Content="当前版本：" />
                                <TextBox
                                    x:Name="text_CurrentMD5Version"
                                    Height="32"
                                    MinWidth="350"
                                    Text="{Binding CurrentMD5Version.Value}" />
                            </StackPanel>

                            <StackPanel Margin="0,8" Orientation="Horizontal">
                                <Label
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Content="安装位置：" />
                                <TextBox
                                    x:Name="text_InstallationPath"
                                    Height="32"
                                    MinWidth="300"
                                    Text="{Binding InstallationPath.Value}" />
                                <Button
                                    x:Name="btn_BrowseInstall"
                                    Width="70"
                                    Margin="10,0,0,0"
                                    Click="BtnBrowseInstall_Click"
                                    Content="浏览..." />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox BorderBrush="{StaticResource GroupBorder}" Header="更新行为设置">
                        <StackPanel>
                            <CheckBox
                                x:Name="checkBox_Kill_App"
                                Margin="0,8"
                                Content="更新前自动终止运行程序"
                                FontSize="14"
                                IsChecked="{Binding Kill_App.Value}" />
                            <CheckBox
                                x:Name="checkBox_Self_Starting"
                                Margin="0,8"
                                Content="自动启动程序"
                                FontSize="14"
                                IsChecked="{Binding Self_Starting.Value}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!--  中间分隔线  -->
            <Rectangle
                Grid.Column="1"
                Width="1"
                Margin="20,10"
                Fill="{DynamicResource BorderBrush}" />

            <StackPanel
                Grid.Column="2"
                Margin="10"
                VerticalAlignment="Top">
                <Button
                    Height="40"
                    Margin="0,0,0,10"
                    Command="{Binding CmdSave}"
                    Content="保存配置"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Height="40"
                    Margin="0,0,0,10"
                    Command="{Binding CmdLoad}"
                    Content="刷新配置"
                    Style="{StaticResource ButtonWarning}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,15,0,0"
            Padding="10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <hc:CircleProgressBar
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    Foreground="#FF007ACC"
                    IsIndeterminate="False"
                    Value="100" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="提示：修改配置后，请点击保存按钮。" />
            </StackPanel>
        </Border>
    </Grid>
</Page>